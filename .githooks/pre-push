#!/bin/sh
set -eu

DOCS_DIR="MD"
DOCS_REMOTE_URL="https://github.com/abdulmoizz44/moizz.git"

if [ ! -d "$DOCS_DIR/.git" ]; then
  echo "pre-push: $DOCS_DIR is not a Git repository; skipping docs push."
  exit 0
fi

cd "$DOCS_DIR"

if [ -n "$DOCS_REMOTE_URL" ]; then
  if git remote get-url origin >/dev/null 2>&1; then
    git remote set-url origin "$DOCS_REMOTE_URL"
  else
    git remote add origin "$DOCS_REMOTE_URL"
  fi
elif ! git remote get-url origin >/dev/null 2>&1; then
  echo "pre-push: docs repository has no origin remote and DOCS_REMOTE_URL is empty; skipping docs push."
  echo "pre-push: set DOCS_REMOTE_URL in .githooks/pre-push to your docs repo URL."
  exit 0
fi

BRANCH="$(git symbolic-ref --quiet --short HEAD || true)"

if [ -z "$BRANCH" ]; then
  echo "pre-push: docs repository is not on a branch; skipping docs push."
  exit 0
fi

if git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
  git push </dev/null
else
  git push -u origin "$BRANCH" </dev/null
fi
